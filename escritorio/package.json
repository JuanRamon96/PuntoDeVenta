{
  "name": "ventastool-offline",
  "productName": "VentasTool Offline",
  "version": "1.0.3",
  "description": "Punto de venta VentasTool para vender sin internet",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copiar": "node scripts/copiar-web.js",
    "start": "npm run copiar && electron .",
    "test": "node pruebas/prueba.js",
    "dist:win": "npm run copiar && electron-builder --win",
    "dist:mac": "npm run copiar && electron-builder --mac"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0"
  },
  "author": "BigTool",
  "build": {
    "appId": "mx.bigtool.ventastool.offline",
    "productName": "VentasTool Offline",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "servidor/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VentasTool Offline",
      "artifactName": "VentasTool-Offline-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "VentasTool-Offline-${version}-${arch}.${ext}"
    }
  }
}
